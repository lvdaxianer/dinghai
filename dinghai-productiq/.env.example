SERVER_PORT=8080
QDRANT_PORT=6333
PRODUCTIQ_SQLITE_PATH=/var/lib/productiq/productiq.db
PRODUCTIQ_TRUSTED_DIRECTORY=/var/lib/productiq/knowledge
PRODUCTIQ_CHAT_TIMEOUT=90s
PRODUCTIQ_ADMIN_KEY=replace-at-deploy-time

# 必须由部署环境注入，不要提交真实密钥。
PRODUCTIQ_OPENAI_BASE_URL=https://gateway.example.internal/v1/chat/completions
PRODUCTIQ_OPENAI_API_KEY=replace-at-deploy-time
PRODUCTIQ_EMBEDDING_MODEL=product-embedding-v1
PRODUCTIQ_RERANK_MODEL=product-rerank-v1
PRODUCTIQ_ANSWER_MODEL=product-answer-v1
PRODUCTIQ_EMBEDDING_DIMENSIONS=1024
PRODUCTIQ_QDRANT_COLLECTION=product-knowledge-v1
