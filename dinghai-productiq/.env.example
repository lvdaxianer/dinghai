SERVER_PORT=8080
QDRANT_PORT=6333

# SQLite 是唯一权威事实源；知识正文不进入 Qdrant payload。
PRODUCTIQ_SQLITE_PATH=/var/lib/productiq/productiq.db
PRODUCTIQ_TRUSTED_DIRECTORY=/var/lib/productiq/knowledge
PRODUCTIQ_CHAT_TIMEOUT=90s
PRODUCTIQ_ADMIN_KEY=replace-at-deploy-time

# 生产部署使用 remote；deterministic 仅用于离线本地运行和测试。
PRODUCTIQ_RUNTIME_MODE=remote

# remote 模式必须完整配置，缺失任一项会在启动时失败。
PRODUCTIQ_GATEWAY_BASE_URL=https://gateway.example.internal/v1/
PRODUCTIQ_GATEWAY_API_KEY=replace-at-deploy-time
PRODUCTIQ_EMBEDDING_MODEL=product-embedding-v1
PRODUCTIQ_RERANK_MODEL=product-rerank-v1
PRODUCTIQ_ANSWER_MODEL=product-answer-v1
PRODUCTIQ_EMBEDDING_DIMENSIONS=1024
PRODUCTIQ_EMBEDDING_TIMEOUT=15s
PRODUCTIQ_RERANK_TIMEOUT=20s

# 每个 embedding 模型和维度必须使用独立 collection。
PRODUCTIQ_QDRANT_URL=http://qdrant:6333
PRODUCTIQ_QDRANT_COLLECTION=product-knowledge-v1
PRODUCTIQ_QDRANT_TIMEOUT=5s

# 索引 worker 在 pending、processing 或 failed 任务存在时保持拒答边界。
PRODUCTIQ_INDEX_WORKER_BATCH_SIZE=20
PRODUCTIQ_INDEX_WORKER_INTERVAL=10s
