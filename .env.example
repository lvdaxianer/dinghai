# >>> project-hygiene (managed, do not edit by hand) >>>
# MinIO
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# 文件存储
DINGHAI_FILE_STORAGE_BUCKET=documents
DINGHAI_FILE_STORAGE_SIGNING_KEY=CHANGE_ME
DINGHAI_FILE_STORAGE_STABLE_ID_KEY=CHANGE_ME
DINGHAI_FILE_STORAGE_CACHE_ROOT=/var/lib/app/file-storage-cache
DINGHAI_FILE_STORAGE_MIGRATION_EXPORT_ROOT=/var/lib/app/file-storage-migration/export
DINGHAI_FILE_STORAGE_MIGRATION_IMPORT_ROOT=/var/lib/app/file-storage-migration/import
DINGHAI_FILE_STORAGE_MIGRATION_COMPLETED_ROOT=/var/lib/app/file-storage-migration/completed
DINGHAI_FILE_STORAGE_MIGRATION_FAILED_ROOT=/var/lib/app/file-storage-migration/failed
DINGHAI_FILE_STORAGE_MINIO_ENDPOINT=http://localhost:9000
DINGHAI_FILE_STORAGE_MINIO_ACCESS_KEY=CHANGE_ME
DINGHAI_FILE_STORAGE_MINIO_SECRET_KEY=CHANGE_ME
# 仅用于 benchmark 的 MinIO bucket
DINGHAI_FILE_STORAGE_MINIO_BUCKET=dinghai-benchmark
# RustFS
DINGHAI_FILE_STORAGE_RUSTFS_ENDPOINT=http://localhost:9100
DINGHAI_FILE_STORAGE_RUSTFS_ACCESS_KEY=CHANGE_ME
DINGHAI_FILE_STORAGE_RUSTFS_SECRET_KEY=CHANGE_ME
# <<< project-hygiene (managed) <<<
